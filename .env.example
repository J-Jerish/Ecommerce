# ─────────────────────────────────────────────
#  Web-Shop Playwright Test Suite — Environment
#  Copy this file to .env and edit as needed.
# ─────────────────────────────────────────────

# Target site (change to point at staging, etc.)
BASE_URL=https://demowebshop.tricentis.com

# Test user (email is always generated dynamically with a timestamp)
USER_FIRST_NAME=Test
USER_LAST_NAME=User
USER_PASSWORD=Test@1234

# Shipping address used during checkout
ADDRESS_COUNTRY=India
ADDRESS_CITY=Chennai
ADDRESS_LINE1=123 Test Street
ADDRESS_ZIP=600001
ADDRESS_PHONE=9876543210

# Search term used in Flow 3
SEARCH_TERM=Fiction

# Coupon code attempted in Flow 8
COUPON_CODE=DiscountCoupon50
